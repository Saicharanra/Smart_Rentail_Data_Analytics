# ==============================================================================
# Smart Retail Analytics Platform — Environment Template
# DO NOT COMMIT ACTUAL SECRET VALUES TO SOURCE CONTROL
# ==============================================================================

# PostgreSQL Operational Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_retail_db?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your_jwt_secret_key_here"

# Azure Cloud Infrastructure Parameters (Phase 9)
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-smart-retail-dev"
AZURE_REGION="centralindia"

# Azure Data Lake Storage Gen2
AZURE_STORAGE_ACCOUNT="stsmartretaildev2026"
AZURE_STORAGE_CONTAINER="retail-data"

# Azure Data Factory
AZURE_DATA_FACTORY="adf-smart-retail-dev"

# Azure Databricks Workspace
AZURE_DATABRICKS_WORKSPACE="dbw-smart-retail-dev"
AZURE_DATABRICKS_URL="https://adb-0000000000000000.0.azuredatabricks.net"

# Azure Synapse Analytics
AZURE_SYNAPSE_WORKSPACE="syn-smart-retail-dev"

# Azure Key Vault
AZURE_KEY_VAULT="kv-smart-retail-dev2026"
